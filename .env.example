# quant_momentum configuration (copy to .env and adjust). All values shown are defaults.

# -- Database --------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://quant:quant_dev_password@postgres:5432/quant

# -- Read API --------------------------------------------------------------
API_PORT=8020
API_LISTEN_ADDRESS=0.0.0.0

# -- Momentum compute ------------------------------------------------------
MOMENTUM_INTERVAL=86400
MOMENTUM_ADJUSTMENT_TYPE=unadjusted
MOMENTUM_LOOKBACKS=5,15,30
MOMENTUM_THRESHOLD_5D=0.0
MOMENTUM_THRESHOLD_15D=0.0
MOMENTUM_THRESHOLD_30D=0.0
MOMENTUM_RULE=ALL
MOMENTUM_MIN_HISTORY=31
MOMENTUM_DIRECTION_MODE=long_only

# -- Watchlist submission --------------------------------------------------
MOMENTUM_SUBMIT_ENABLED=true
MOMENTUM_SOURCE=momentum-v1
MOMENTUM_HORIZON=30d
MOMENTUM_SCORE_SCALE=30.0

# -- quant_signals client --------------------------------------------------
QUANT_SIGNALS_BASE_URL=http://quant_signals:8016
QUANT_SIGNALS_TIMEOUT_SECONDS=10
QUANT_SIGNALS_RETRY_COUNT=3
QUANT_SIGNALS_BACKOFF_SECONDS=0.5

# -- Optional Redis (run lock / heartbeat only; leave unset to disable) ----
# QUANT_REDIS_URL=redis://redis:6379/0
